# Copy to .env and fill in. Never commit .env.

# --- Models ----------------------------------------------------------------------
# build.nvidia.com keys (free). Comma-separate several keys to rotate them:
# every teammate's key adds rate-limit room.
NVIDIA_API_KEYS=
# OpenRouter key, used only when NVIDIA fails.
OPENROUTER_API_KEY=

# One model per job. IDs checked against both catalogs on Sat Nov 7.
# See what's available: uv run python -m scripts.smoke_llm --list-models
MANAGER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
VOICE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
RESIDENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENROUTER_MANAGER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_VOICE_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_RESIDENT_MODEL=nvidia/nemotron-3.5-lightning:free

# How "thinking" is switched on and off for each provider.
# NVIDIA: chat_template_kwargs | system_tag | none.  OpenRouter: reasoning | none.
# The smoke test prints "reasoning yes/no" so you can see whether the switch works.
NVIDIA_THINKING_STYLE=chat_template_kwargs
OPENROUTER_THINKING_STYLE=reasoning
LLM_MAX_CONCURRENCY=8
LLM_TIMEOUT_S=60

# --- Phone and texts (M1, M6) ------------------------------------------------------
VAPI_API_KEY=
# Id of the number calls come from. Free Vapi numbers can't dial out: import a Twilio,
# Vonage or Telnyx number in the Vapi dashboard and use its id.
VAPI_PHONE_NUMBER_ID=
# Printed by: uv run python -m scripts.vapi_setup
VAPI_ASSISTANT_ID=
# Optional shared secret. When set, /vapi/* requires it in the X-Vapi-Secret header,
# and scripts.vapi_setup tells Vapi to send it. Re-run vapi_setup after changing it.
VAPI_WEBHOOK_SECRET=
# Voice, transcriber and call limit used by scripts.vapi_setup (defaults shown).
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-3
VAPI_MAX_CALL_S=180
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Teammate phone that plays the human dispatcher, in E.164 format (+1...)
DISPATCHER_PHONE=
# Public HTTPS URL of the backend (cloudflared or ngrok) for Vapi and Twilio webhooks
PUBLIC_BASE_URL=

# --- App -------------------------------------------------------------------------------
# /debug/emit lets scripts inject events. Turn it off before exposing the backend for judging.
DEBUG_ENDPOINTS=true
